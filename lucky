local function obterTempoLuckyBlock()
    local ok, resultado = pcall(function()
        local sharedModule = ReplicatedStorage:FindFirstChild("Features")
            and ReplicatedStorage.Features:FindFirstChild("LuckyBlock")
            and ReplicatedStorage.Features.LuckyBlock:FindFirstChild("LuckyBlockShared")
        
        if not sharedModule then return nil end
        local LuckyBlockShared = require(sharedModule)
        
        local npc = Workspace
        for _, v in ipairs(LuckyBlockShared.NPC_PATH) do
            npc = npc:FindFirstChild(v)
        end
        if not npc then return nil end
        
        if npc:GetAttribute(LuckyBlockShared.SPAWN_DISABLED_ATTRIBUTE) == true then
            return "OFF"
        end
        
        local nextSpawn = npc:GetAttribute(LuckyBlockShared.NEXT_SPAWN_ATTRIBUTE)
        if typeof(nextSpawn) ~= "number" then
            return "Aguardando"
        end
        
        local restante = nextSpawn - Workspace:GetServerTimeNow()
        if restante <= 0 then
            return "PRONTO!"
        end
        
        local segundos = math.max(0, math.floor(restante))
        local h = segundos // 3600
        local m = (segundos % 3600) // 60
        local s = segundos % 60
        
        if h > 0 then
            return string.format("%02d:%02d:%02d", h, m, s)
        else
            return string.format("%02d:%02d", m, s)
        end
    end)
    
    if ok and resultado then
        return resultado
    end
    return "--:--"
end

