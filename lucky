local function getBlocoInfo(bloco)
    if not bloco then return nil, Vector3.new(3,3,3), Color3.fromRGB(255,215,0) end

    local cube = bloco:FindFirstChild("Cube")
    if cube and cube:IsA("BasePart") then
        return cube, cube.Size, cube.Color
    end

    if bloco:IsA("BasePart") then
        return bloco, bloco.Size, bloco.Color
    elseif bloco:IsA("Model") then
        local primary = bloco.PrimaryPart or bloco:FindFirstChildWhichIsA("BasePart", true)
        if primary then
            -- Previne erros se o BoundingBox bugar em blocos já carregados
            local ok, cframe, size = pcall(function() return bloco:GetBoundingBox() end)
            if ok then
                return primary, size, primary.Color
            else
                return primary, primary.Size, primary.Color
            end
        end
    end
    
    -- Busca agressiva se for uma pasta
    local anyPart = bloco:FindFirstChildWhichIsA("BasePart", true)
    if anyPart then return anyPart, anyPart.Size, anyPart.Color end
    
    return nil, Vector3.new(3, 3, 3), Color3.fromRGB(255, 215, 0)
end

local function getNearestLuckyBlock()
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local hrp = character.HumanoidRootPart
    
    local pasta = Workspace:FindFirstChild("LuckyBlocksActive")
    if not pasta then return nil end
    
    local nearestPos = nil
    local nearestColor = Color3.fromRGB(0, 255, 255)
    local minDistance = math.huge
    
    for _, bloco in pairs(pasta:GetChildren()) do
        local mainPart, _, color = getBlocoInfo(bloco)
        local pos = nil
        
        -- Garante que vai achar a posição mesmo se o bloco tiver nascido antes do script
        if mainPart then
            pos = mainPart.Position
        else
            pcall(function()
                if bloco:IsA("Model") then
                    pos = bloco:GetPivot().Position
                elseif bloco:IsA("BasePart") then
                    pos = bloco.Position
                end
            end)
        end
        
        if pos then
            local dist = (hrp.Position - pos).Magnitude
            if dist < minDistance then
                minDistance = dist
                nearestPos = pos
                nearestColor = color or Color3.fromRGB(0, 255, 255)
            end
        end
    end
    
    return nearestPos, nearestColor
end

local espAtivo = false
local espObjects = {} 
local espRenderConnection = nil

local function limparESP()
    for bloco, objs in pairs(espObjects) do
        for _, obj in pairs(objs) do
            if obj then obj:Destroy() end
        end
    end
    table.clear(espObjects)
end

local function atualizarESP()
    if not espAtivo then 
        limparESP()
        return 
    end
    
    local pasta = Workspace:FindFirstChild("LuckyBlocksActive")
    if not pasta then return end
    
    local blocosAtuais = {}
    
    for _, bloco in pairs(pasta:GetChildren()) do
        blocosAtuais[bloco] = true
        
        if not espObjects[bloco] then
            local mainPart, size, blockColor = getBlocoInfo(bloco)
            
            if mainPart then
                local objs = {}
                
                local box = Instance.new("BoxHandleAdornment")
                box.Size = size
                box.Adornee = mainPart
                box.AlwaysOnTop = true
                box.Color3 = blockColor
                box.Transparency = 0.2
                box.ZIndex = 10
                box.Parent = ScreenGui
                table.insert(objs, box)

                local sel = Instance.new("SelectionBox")
                sel.Adornee = bloco
                sel.Color3 = blockColor
                sel.LineThickness = 0.08
                sel.AlwaysOnTop = true
                sel.Parent = ScreenGui
                table.insert(objs, sel)

                local bgui = Instance.new("BillboardGui")
                bgui.Adornee = mainPart
                bgui.Size = UDim2.new(15, 0, 4.5, 0)
                bgui.AlwaysOnTop = true
                bgui.ExtentsOffset = Vector3.new(0, (size.Y/2) + 3, 0)
                
                local texto = Instance.new("TextLabel", bgui)
                texto.Size = UDim2.new(1, 0, 1, 0)
                texto.BackgroundTransparency = 1
                texto.Text = "LUCKY BLOCK"
                texto.TextColor3 = blockColor
                texto.TextStrokeTransparency = 0.2
                texto.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                texto.Font = Enum.Font.GothamBlack
                texto.TextScaled = true 
                texto.TextYAlignment = Enum.TextYAlignment.Bottom
                
                bgui.Parent = ScreenGui
                table.insert(objs, bgui)
                
                espObjects[bloco] = objs
            end
        end
    end
    
    for bloco, objs in pairs(espObjects) do
        if not blocosAtuais[bloco] or not bloco.Parent then
            for _, obj in pairs(objs) do
                if obj then obj:Destroy() end
            end
            espObjects[bloco] = nil
        end
    end
end

EspButton.MouseButton1Click:Connect(function()
    espAtivo = not espAtivo
    if espAtivo then
        EspButton.Text = "ESP Lucky Block: ON"
        EspButton.TextColor3 = Color3.fromRGB(100, 255, 100)
        pointerBase.Parent = Workspace
        
        atualizarESP() 
        
        espRenderConnection = RunService.RenderStepped:Connect(function(deltaTime)
            local char = player.Character
            if char and char:FindFirstChild("Head") then
                local head = char.Head
                local targetPos, targetColor = getNearestLuckyBlock()
                
                if targetPos then
                    shaft.Visible = true
                    tip.Visible = true
                    shaft.Color3 = targetColor
                    tip.Color3 = targetColor
                    
                    local headPos = head.Position + Vector3.new(0, 6.5, 0)
                    
                    -- Proteção contra crash se a seta e o bloco estiverem exatamente no mesmo pixel
                    if (headPos - targetPos).Magnitude > 0.5 then
                        local targetCFrame = CFrame.lookAt(headPos, targetPos)
                        
                        if pointerBase.Position == Vector3.new(0,0,0) or (pointerBase.Position - headPos).Magnitude > 50 then
                            pointerBase.CFrame = targetCFrame
                        else
                            -- Suaviza apenas a rotação, mantendo preso na cabeça firmemente
                            local currentRotation = pointerBase.CFrame - pointerBase.CFrame.Position
                            local targetRotation = targetCFrame - targetCFrame.Position
                            local lerpedRotation = currentRotation:Lerp(targetRotation, 15 * deltaTime)
                            
                            pointerBase.CFrame = CFrame.new(headPos) * lerpedRotation
                        end
                    end
                else
                    shaft.Visible = false
                    tip.Visible = false
                end
            else
                shaft.Visible = false
                tip.Visible = false
            end
        end)
    else
        EspButton.Text = "ESP Lucky Block: OFF"
        EspButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        limparESP()
        pointerBase.Parent = nil
        shaft.Visible = false
        tip.Visible = false
        if espRenderConnection then
            espRenderConnection:Disconnect()
            espRenderConnection = nil
        end
    end
end)

