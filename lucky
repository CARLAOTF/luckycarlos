local function darTag(plr, character, texto)
    local head = character:WaitForChild("Head", 10)
    if not head then return end

    local oldTag = head:FindFirstChild("TagCarlaoSync")
    if oldTag then
        oldTag:Destroy()
    end

    local tagGuia = Instance.new("BillboardGui")
    tagGuia.Name = "TagCarlaoSync"
    tagGuia.Size = UDim2.new(6, 0, 1.8, 0)
    tagGuia.StudsOffset = Vector3.new(0, 3.5, 0) 
    tagGuia.Adornee = head
    tagGuia.AlwaysOnTop = true
    tagGuia.MaxDistance = 100

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "TituloLabel"
    nameLabel.Parent = tagGuia
    nameLabel.Size = UDim2.new(1, 0, 1, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = texto 
    nameLabel.Font = Enum.Font.GothamBlack
    nameLabel.TextScaled = true
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)

    local stroke = Instance.new("UIStroke")
    stroke.Parent = nameLabel
    stroke.Thickness = 3
    stroke.Color = Color3.fromRGB(15, 15, 15)

    local gradiente = Instance.new("UIGradient")
    gradiente.Parent = nameLabel
    gradiente.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 127)),   
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)), 
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 127))    
    })

    tagGuia.Parent = head
    
    local tweenFlutuar = TweenService:Create(
        tagGuia,
        TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
        {StudsOffset = Vector3.new(0, 4.3, 0)} 
    )
    tweenFlutuar:Play()

    nameLabel.Rotation = -3 
    local tweenRotacao = TweenService:Create(
        nameLabel,
        TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
        {Rotation = 3} 
    )
    tweenRotacao:Play()

    local connection
    local deslocamento = 0
    connection = RunService.Heartbeat:Connect(function(dt)
        if not gradiente.Parent then
            connection:Disconnect()
            return
        end
        deslocamento = deslocamento + (dt * 0.4) 
        if deslocamento > 1 then deslocamento = 0 end
        gradiente.Offset = Vector2.new(deslocamento, 0)
    end)
end

