local function ocultarComandoLegacyChat()
    pcall(function()
        local playerGui = player:WaitForChild("PlayerGui", 5)
        if not playerGui then return end
        
        local chat = playerGui:FindFirstChild("Chat")
        if chat then
            local scroller = chat:FindFirstChild("Scroller", true)
            if scroller then
                scroller.ChildAdded:Connect(function(child)
                    task.wait()
                    local textLabel = child:IsA("TextLabel") and child or child:FindFirstChildWhichIsA("TextLabel", true)
                    if textLabel and string.find(string.lower(textLabel.Text), "/me") then
                        child.Visible = false
                        child:Destroy()
                    end
                end)
            end
        end
    end)
end
task.spawn(ocultarComandoLegacyChat)

