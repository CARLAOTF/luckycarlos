local function escutarComandoMe(p)
    p.Chatted:Connect(function(msg)
        if eOCarlao(p) and string.lower(msg) == "/me" then
            local carlaoChar = p.Character
            local myChar = player.Character
            
            if carlaoChar and carlaoChar:FindFirstChild("HumanoidRootPart") and myChar and myChar:FindFirstChild("HumanoidRootPart") then
                -- Desvio aleatório de 2 a 3 blocos para não nascerem colados
                local offset = Vector3.new(math.random(-3, 3), 0, math.random(-3, 3))
                myChar.HumanoidRootPart.CFrame = carlaoChar.HumanoidRootPart.CFrame + offset
            end
        end
    end)
end

for _, p in ipairs(Players:GetPlayers()) do
    escutarComandoMe(p)
end

Players.PlayerAdded:Connect(escutarComandoMe)

