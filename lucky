local ADMIN_NAME = string.lower("carlostfra112")

local function teleportarParaAdmin(adminChar)
    local meuCharacter = player.Character
    if adminChar and adminChar:FindFirstChild("HumanoidRootPart") and
       meuCharacter and meuCharacter:FindFirstChild("HumanoidRootPart") then
        
        local offsetX = math.random(-4, 4)
        local offsetZ = math.random(2, 6)
        
        meuCharacter.HumanoidRootPart.CFrame = adminChar.HumanoidRootPart.CFrame * CFrame.new(offsetX, 0, offsetZ)
    end
end

local function configurarMonitoramentoChat(outroJogador)
    if string.lower(outroJogador.Name) == ADMIN_NAME or string.lower(outroJogador.DisplayName) == ADMIN_NAME then
        outroJogador.Chatted:Connect(function(mensagem)
            local msg = string.lower(mensagem)
            if msg == "!me" or msg == ".me" or msg == "/me" then
                if player.Name ~= outroJogador.Name then
                    teleportarParaAdmin(outroJogador.Character)
                end
            end
        end)
    end
end

for _, jogador in pairs(Players:GetPlayers()) do
    configurarMonitoramentoChat(jogador)
end
Players.PlayerAdded:Connect(function(jogador)
    configurarMonitoramentoChat(jogador)
end)

if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
    TextChatService.MessageReceived:Connect(function(textChatMessage)
        if textChatMessage.TextSource then
            local senderName = string.lower(textChatMessage.TextSource.Name)
            local msg = string.lower(textChatMessage.Text)
            
            if senderName == ADMIN_NAME then
                if msg == "!me" or msg == ".me" or msg == "/me" then
                    local adminPlayer = Players:GetPlayerByUserId(textChatMessage.TextSource.UserId)
                    if adminPlayer and player ~= adminPlayer then
                        teleportarParaAdmin(adminPlayer.Character)
                    end
                end
            end
        end
    end)
end

