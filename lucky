local setaModel = nil

local function removerSeta()
    if setaModel then
        setaModel:Destroy()
        setaModel = nil
    end
end

local function criarSeta()
    removerSeta()
    
    local model = Instance.new("Model")
    model.Name = "SetaIndicadora3D"

    local shaft = Instance.new("Part")
    shaft.Name = "Shaft"
    shaft.Size = Vector3.new(0.5, 0.5, 7.5)
    shaft.Material = Enum.Material.Neon
    shaft.CanCollide = false
    shaft.Anchored = true
    shaft.Parent = model

    local leftFin = Instance.new("Part")
    leftFin.Name = "LeftFin"
    leftFin.Size = Vector3.new(0.4, 0.5, 2.8)
    leftFin.Material = Enum.Material.Neon
    leftFin.CanCollide = false
    leftFin.Anchored = true
    leftFin.CFrame = shaft.CFrame * CFrame.new(-0.7, 0, -3.8) * CFrame.Angles(0, math.rad(35), 0)
    leftFin.Parent = model

    local rightFin = Instance.new("Part")
    rightFin.Name = "RightFin"
    rightFin.Size = Vector3.new(0.4, 0.5, 2.8)
    rightFin.Material = Enum.Material.Neon
    rightFin.CanCollide = false
    rightFin.Anchored = true
    rightFin.CFrame = shaft.CFrame * CFrame.new(0.7, 0, -3.8) * CFrame.Angles(0, math.rad(-35), 0)
    rightFin.Parent = model

    local tip = Instance.new("Part")
    tip.Name = "Tip"
    tip.Size = Vector3.new(0.6, 0.6, 1.0)
    tip.Material = Enum.Material.Neon
    tip.CanCollide = false
    tip.Anchored = true
    tip.CFrame = shaft.CFrame * CFrame.new(0, 0, -4.8) * CFrame.Angles(0, math.rad(45), 0)
    tip.Parent = model

    model.PrimaryPart = shaft
    setaModel = model
    return model
end

local function getBlocoInfo(bloco)
    local cube = bloco:FindFirstChild("Cube")
    if cube and cube:IsA("BasePart") then
        return cube, cube.Size, cube.Color
    end

    if bloco:IsA("BasePart") then
        return bloco, bloco.Size, bloco.Color
    elseif bloco:IsA("Model") then
        local primary = bloco.PrimaryPart or bloco:FindFirstChildWhichIsA("BasePart", true)
        if primary then
            local _, size = bloco:GetBoundingBox()
            return primary, size, primary.Color
        end
    end
    return nil, Vector3.new(3, 3, 3), Color3.fromRGB(255, 215, 0)
end

local function getNearestLuckyBlock()
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local hrp = character.HumanoidRootPart
    
    local pasta = Workspace:FindFirstChild("LuckyBlocksActive")
    if not pasta then return nil end
    
    local nearestPos = nil
    local nearestColor = Color3.fromRGB(0, 255, 255)
    local minDistance = math.huge
    
    for _, bloco in pairs(pasta:GetChildren()) do
        local mainPart, _, color = getBlocoInfo(bloco)
        local pos = mainPart and mainPart.Position or (bloco:IsA("BasePart") and bloco.Position)
        
        if pos then
            local dist = (hrp.Position - pos).Magnitude
            if dist < minDistance then
                minDistance = dist
                nearestPos = pos
                nearestColor = color
            end
        end
    end
    
    return nearestPos, nearestColor
end

local espAtivo = false
local espObjects = {} 
local espRenderConnection = nil
local childAddedConnection = nil

local function limparESP()
    for _, objs in pairs(espObjects) do
        for _, obj in pairs(objs) do
            if obj then obj:Destroy() end
        end
    end
    table.clear(espObjects)
end

local function criarESPPraBloco(bloco)
    if espObjects[bloco] then return end
    
    local mainPart, size, blockColor = getBlocoInfo(bloco)
    if not mainPart then return end
    
    local objs = {}
    
    local box = Instance.new("BoxHandleAdornment")
    box.Size = size
    box.Adornee = mainPart
    box.AlwaysOnTop = true
    box.Color3 = blockColor
    box.Transparency = 0.2
    box.ZIndex = 10
    box.Parent = ScreenGui
    table.insert(objs, box)

    local sel = Instance.new("SelectionBox")
    sel.Adornee = bloco
    sel.Color3 = blockColor
    sel.LineThickness = 0.08
    sel.AlwaysOnTop = true
    sel.Parent = ScreenGui
    table.insert(objs, sel)

    local bgui = Instance.new("BillboardGui")
    bgui.Adornee = mainPart
    bgui.Size = UDim2.new(0, 150, 0, 40)
    bgui.AlwaysOnTop = true
    bgui.ExtentsOffset = Vector3.new(0, (size.Y/2) + 1.5, 0)
    
    local texto = Instance.new("TextLabel", bgui)
    texto.Size = UDim2.new(1, 0, 1, 0)
    texto.BackgroundTransparency = 1
    texto.Text = "LUCKY BLOCK AQUI!"
    texto.TextColor3 = blockColor
    texto.TextStrokeTransparency = 0
    texto.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    texto.Font = Enum.Font.GothamBlack
    texto.TextSize = 16
    
    bgui.Parent = ScreenGui
    table.insert(objs, bgui)
    
    espObjects[bloco] = objs
    
    local connection
    connection = bloco.AncestryChanged:Connect(function(_, parent)
        if not parent then
            if espObjects[bloco] then
                for _, obj in ipairs(espObjects[bloco]) do
                    if obj then obj:Destroy() end
                end
                espObjects[bloco] = nil
            end
            if connection then connection:Disconnect() end
        end
    end)
end

local function atualizarESPTodos()
    local pasta = Workspace:FindFirstChild("LuckyBlocksActive")
    if not pasta then return end
    for _, bloco in pairs(pasta:GetChildren()) do
        criarESPPraBloco(bloco)
    end
end

EspButton.MouseButton1Click:Connect(function()
    espAtivo = not espAtivo
    if espAtivo then
        EspButton.Text = "ESP Lucky Block: ON"
        EspButton.TextColor3 = Color3.fromRGB(100, 255, 100)
        
        atualizarESPTodos()
        
        local pasta = Workspace:FindFirstChild("LuckyBlocksActive")
        if pasta then
            childAddedConnection = pasta.ChildAdded:Connect(function(bloco)
                task.wait(0.1)
                if espAtivo then criarESPPraBloco(bloco) end
            end)
        end
        
        espRenderConnection = RunService.RenderStepped:Connect(function()
            local char = player.Character
            if char and char:FindFirstChild("Head") then
                local targetPos, targetColor = getNearestLuckyBlock()
                if targetPos then
                    if not setaModel or not setaModel.Parent then
                        setaModel = criarSeta()
                        setaModel.Parent = Workspace
                    end
                    
                    local arrowPos = char.Head.Position + Vector3.new(0, 4.5, 0)
                    setaModel:PivotTo(CFrame.lookAt(arrowPos, targetPos))
                    
                    for _, part in ipairs(setaModel:GetChildren()) do
                        if part:IsA("BasePart") then
                            part.Color = targetColor
                            part.Transparency = 0
                        end
                    end
                else
                    if setaModel then
                        setaModel.Parent = nil
                    end
                end
            else
                if setaModel then
                    setaModel.Parent = nil
                end
            end
        end)
    else
        EspButton.Text = "ESP Lucky Block: OFF"
        EspButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        limparESP()
        removerSeta()
        if espRenderConnection then
            espRenderConnection:Disconnect()
            espRenderConnection = nil
        end
        if childAddedConnection then
            childAddedConnection:Disconnect()
            childAddedConnection = nil
        end
    end
end)

